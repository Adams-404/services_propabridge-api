# =============================================
# PROPABRIDGE — Environment Variables
# Copy this to .env and fill in your values
# =============================================

# Server
PORT=8080
NODE_ENV=development

# Google Cloud / Firebase
GOOGLE_CLOUD_PROJECT=propabridge-prod
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://propabridge-prod-default-rtdb.firebaseio.com

# Gemini AI (Google Generative AI SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Calendar (OAuth)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CLIENT_ID=your_calendar_client_id_here
GOOGLE_CALENDAR_CLIENT_SECRET=your_calendar_client_secret_here
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/calendar/callback

# Twilio (WhatsApp + SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_TEMPLATE_ID=your_template_id_here

# Admin contact (gets fraud alerts and hot lead notifications)
ADMIN_PHONE=+2348012345678
ADMIN_EMAIL=admin@propabridge.com
ADMIN_WHATSAPP=whatsapp:+2348012345678

# App
APP_BASE_URL=https://propabridge.com
API_BASE_URL=https://api.propabridge.com
